function openSectionForField(field) {
    const section = field.closest(".section");

    if (section) {
        section.classList.add("open");

        const body = section.querySelector(".section-body");
        if (body) {
            body.style.display = "block";
        }
    }

    setTimeout(function () {
        try {
            field.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

            field.focus();
        } catch (error) {
            console.warn("Impossible de focus le champ :", field.name);
        }
    }, 100);
}

function validateRequiredFields(form) {
    const requiredFields = Array.from(form.querySelectorAll("[required]"));

    for (const field of requiredFields) {
        if (field.disabled) {
            continue;
        }

        if (field.type === "hidden") {
            continue;
        }

        const value = (field.value || "").trim();

        if (!value) {
            openSectionForField(field);

            const label = field.closest("div")
                ? field.closest("div").querySelector("label")
                : null;

            const labelText = label
                ? label.innerText.replace("*", "").trim()
                : field.name;

            alert("Veuillez renseigner le champ obligatoire : " + labelText);

            return false;
        }
    }

    return true;
}



/* ==========================================================
   V7 - Capture adaptative pièce d’identité
   Objectif : le cadre ne reste plus fixe. Il se rétrécit ou
   s’agrandit selon la proximité réelle de la pièce détectée.
   ========================================================== */
let adaptiveDocumentFrame = null;
let adaptiveFrameInitialized = false;

function getDocumentCaptureProfile() {
    const type = getSelectedDocumentType();

    if (type === "Passeport") {
        return {
            key: "passport",
