    function normalizeText(value) {
        return String(value || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .trim();
    }

    function setFieldMessage(id, message, type = "") {
        const element = document.getElementById(id);
        if (!element) {
