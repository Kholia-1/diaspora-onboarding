                : "Placez votre visage dans le cadre et enregistrez une courte vidéo de 5 à 10 secondes.";

        setSmartMessage(
            "selfieQualityMessage",
            selfieMode === "photo"
                ? "Analyse du cadrage visage en cours..."
                : "Pour la vidéo, regardez la caméra et restez stable.",
