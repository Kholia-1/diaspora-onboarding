<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Configuration packages</title>
<style>
body{font-family:Arial,Helvetica,sans-serif;background:#f4f6f9;margin:0;color:#111827}
.page{max-width:980px;margin:auto;padding:28px}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
a{color:#c90000;text-decoration:none;font-weight:bold}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:20px;margin-bottom:16px;box-shadow:0 8px 22px rgba(15,23,42,.06)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
label{display:block;font-weight:700;margin-bottom:6px}
input,textarea{width:100%;box-sizing:border-box;padding:11px;border:1px solid #d1d5db;border-radius:10px}
textarea{min-height:74px}
button{background:#c90000;color:#fff;border:0;border-radius:12px;padding:13px 18px;font-weight:bold;cursor:pointer}
.package-title{display:flex;justify-content:space-between;gap:12px;align-items:center}
.badge{padding:6px 10px;border-radius:999px;background:#dcfce7;color:#166534;font-size:12px;font-weight:bold}
.message{margin-top:12px;font-weight:bold}
@media(max-width:700px){.grid{grid-template-columns:1fr}.top{display:block}}
</style>
</head>
<body>
<div class="page">
<div class="top">
<div>
<h1>Configuration des packages</h1>
<p>Modifiez les packages affichés dans le formulaire d’ouverture de compte.</p>
</div>
<a href="/backoffice/applications">Retour back-office</a>
</div>

<div id="packages"></div>

<button onclick="savePackages()">Enregistrer les packages</button>
<div id="message" class="message"></div>
</div>

<script>
let packages = [];

function escapeHtml(v){
 return String(v || "").replace(/[&<>"']/g, function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;","\\"":"&quot;","'":"&#039;"}[c];
 });
}

async function loadPackages(){
 const res = await fetch("/api/backoffice/packages");
 const data = await res.json();
 packages = data.packages || [];
 renderPackages();
}

function renderPackages(){
 const container = document.getElementById("packages");
 container.innerHTML = "";

 packages.forEach(function(pkg, index){
  container.innerHTML += `
   <div class="card">
    <div class="package-title">
     <h2>${escapeHtml(pkg.name)}</h2>
     <label><input type="checkbox" id="active_${index}" ${pkg.active ? "checked" : ""}> Actif</label>
    </div>

    <div class="grid">
     <div>
      <label>Code</label>
      <input id="code_${index}" value="${escapeHtml(pkg.code)}">
     </div>

     <div>
      <label>Nom</label>
      <input id="name_${index}" value="${escapeHtml(pkg.name)}">
     </div>
    </div>

    <label>Description</label>
    <textarea id="description_${index}">${escapeHtml(pkg.description)}</textarea>

    <label>Services inclus</label>
    <textarea id="services_${index}" placeholder="Un service par ligne">${escapeHtml((pkg.services || []).join("\\n"))}</textarea>
   </div>
  `;
 });
}

async function savePackages(){
 const updated = packages.map(function(pkg, index){
  return {
   code: document.getElementById("code_" + index).value.trim(),
   name: document.getElementById("name_" + index).value.trim(),
   description: document.getElementById("description_" + index).value.trim(),
   services: document.getElementById("services_" + index).value.split("\\n").map(x => x.trim()).filter(Boolean),
   active: document.getElementById("active_" + index).checked
  };
 });

 const msg = document.getElementById("message");
 msg.style.color = "#6b7280";
 msg.innerText = "Enregistrement en cours...";

 const res = await fetch("/api/backoffice/packages", {
  method: "POST",
  headers: {"Content-Type": "application/json"},
  body: JSON.stringify({packages: updated})
 });

 if(!res.ok){
  msg.style.color = "#c90000";
  msg.innerText = "Erreur lors de l’enregistrement.";
  return;
 }

 msg.style.color = "#166534";
 msg.innerText = "Packages enregistrés avec succès.";
 await loadPackages();
}

loadPackages();
</script>
</body>
</html>
