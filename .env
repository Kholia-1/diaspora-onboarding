# Application
APP_ENV=development
APP_NAME=diaspora-onboarding

# OTP WhatsApp
PRE_ONBOARDING_OTP_DEMO_MODE=false
# Contournement temporaire : affiche le code OTP a l'ecran si l'envoi WhatsApp echoue
# (souci de facturation Meta). Mettre a false des que WhatsApp refonctionne.
PRE_ONBOARDING_OTP_FALLBACK_DISPLAY=true
PRE_ONBOARDING_OTP_TTL_MINUTES=10
PRE_ONBOARDING_OTP_MAX_ATTEMPTS=5
PRE_ONBOARDING_OTP_SECRET=diaspora-onboarding-demo-secret-change-me

# Callbell / WhatsApp (compte Afriland First Bank)
CALLBELL_ENABLED=true
CALLBELL_API_TOKEN=e4zdvmXhjRVjvpoA8qAc1oiJjsoT3iRG.7b423e833c6bf93878fc17827908f5652ee76cbee33e206d003109d2d0ac3bd4
CALLBELL_CHANNEL_UUID=36c1b1927262494984f9aefc45b2e3b7
CALLBELL_TEMPLATE_UUID=14af6cbdbc264f58bc8eb71375bea51b
# false = envoi en texte libre (gratuit, non bloque par le souci de facturation
# Meta 131042 qui ne touche que les conversations template). Necessite que le
# destinataire ait ecrit au numero WhatsApp dans les dernieres 24 h, sinon
# fallback affichage du code a l'ecran. Remettre a true une fois la facturation
# Meta corrigee dans le Business Manager.
CALLBELL_USE_TEMPLATE=false
