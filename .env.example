# ------------------------------------------------------------------
# Configuration diaspora-onboarding
# Copier ce fichier vers .env puis renseigner les valeurs.
#   cp .env.example .env
# ------------------------------------------------------------------

# Clé de chiffrement Fernet des documents (OBLIGATOIRE en production).
# DOIT rester stable : si elle change, les documents .enc déjà chiffrés
# deviennent indéchiffrables. Générer une clé une seule fois avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# URL du service de screening BLACKMODULE
BLACKMODULE_SCREENING_URL=http://127.0.0.1:8000/api/matching/screen

# Langue OCR Tesseract (fra installée dans l'image)
TESSERACT_LANG=fra

# DATABASE_URL est défini dans docker-compose.yml (SQLite persisté dans ./data).
# Décommenter uniquement pour pointer vers une autre base.
# DATABASE_URL=sqlite:////app/data/diaspora_onboarding.db
