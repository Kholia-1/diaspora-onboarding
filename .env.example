# Application
APP_ENV=production
APP_NAME=diaspora-onboarding

# OTP WhatsApp
PRE_ONBOARDING_OTP_DEMO_MODE=false
PRE_ONBOARDING_OTP_TTL_MINUTES=10
PRE_ONBOARDING_OTP_MAX_ATTEMPTS=5
PRE_ONBOARDING_OTP_SECRET=change-me

# Callbell / WhatsApp
CALLBELL_ENABLED=true
CALLBELL_API_TOKEN=change-me
CALLBELL_CHANNEL_UUID=change-me

# Mastercard
MASTERCARD_ENABLED=false
MASTERCARD_ENVIRONMENT=SANDBOX
MASTERCARD_MERCHANT_ID=change-me
MASTERCARD_API_PASSWORD=change-me

# Database
DATABASE_URL=change-me
